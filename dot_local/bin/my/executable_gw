#!/bin/bash

# Git Worktree command

# set -u は使わない。フラグだけを渡したときの `set -- "${POSITIONAL[@]}"` が
# bash 3.2 (macOS 同梱) では空配列展開で unbound variable になる。
# 処理を止めるべき失敗は呼び出し箇所ごとに判定して exit 1 する

# デフォルト設定 (設定ファイルで上書き可能)
REMOTE="origin"
WORKTREE_DIR=".w"
POST_CREATE_CMD=""

# 設定ファイル: ~/.config/gw/config (bash として source される)
GW_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gw/config"
if [ -f "$GW_CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$GW_CONFIG_FILE"
fi

# リポジトリのメインディレクトリ
MAIN_REPO_ROOT=$(realpath "$(git rev-parse --git-common-dir)/..")

# 引数がなければ、worktreeの一覧を表示
if [ "$#" -eq 0 ]; then
  echo "Usage: gw [-f <file>] [-y] [-n] <branch-name> [<start-point>]"
  echo "       gw [-f <file>] [-y] [-n] --detach <commit>"
  echo
  echo "Options:"
  echo "  -f <file>        Open <file> in the worktree after creation"
  echo "  --detach         Create a detached HEAD worktree at the given commit"
  echo "  -y, --yes        Auto-confirm branch creation prompt"
  echo "  -n, --no-editor  Skip launching the editor after worktree creation"
  echo "  -p, --post-script-args <string>"
  echo "                   Space-separated tokens passed to POST_CREATE_CMD"
  echo "                   as GW_POST_SCRIPT_ARGS (interpretation is up to the script)"
  echo

  ROOT_LINK=""
  ROOT_DISPLAY="$MAIN_REPO_ROOT"
  worktree_lines=()
  while IFS= read -r line; do
    wt_path="${line%% *}"
    rest="${line#"$wt_path"}"
    if ! wt_real=$(realpath "$wt_path" 2> /dev/null); then
      worktree_lines+=("$line")
      continue
    fi
    if [[ "$wt_real" != "$MAIN_REPO_ROOT" && "$wt_real" != "$MAIN_REPO_ROOT"/* ]]; then
      worktree_lines+=("$line")
      continue
    fi

    rel="${wt_real#"$MAIN_REPO_ROOT"}"
    if [ -z "$rel" ]; then
      worktree_lines+=("/${rest}")
      candidate="$wt_path"
    else
      worktree_lines+=("${rel}${rest}")
      candidate="${wt_path%"$rel"}"
      candidate="${candidate%/}"
    fi
    if [ -z "$ROOT_LINK" ] && [ "$candidate" != "$MAIN_REPO_ROOT" ]; then
      ROOT_LINK="$candidate"
      ROOT_DISPLAY="$ROOT_LINK -> $MAIN_REPO_ROOT"
    fi
  done < <(git worktree list)

  echo "Worktrees: (Root: $ROOT_DISPLAY)"
  printf '%s\n' "${worktree_lines[@]}" | column -t
  exit 0
fi

# 引数を変数に格納
TARGET_FILE=""
DETACH=""
ASSUME_YES=""
NO_EDITOR=""
POST_SCRIPT_ARGS=""
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    -f)
      TARGET_FILE=$2
      shift 2
      ;;
    --detach)
      DETACH=1
      shift
      ;;
    -y | --yes)
      ASSUME_YES=1
      shift
      ;;
    -n | --no-editor)
      NO_EDITOR=1
      shift
      ;;
    -p | --post-script-args)
      POST_SCRIPT_ARGS=$2
      shift 2
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done
set -- "${POSITIONAL[@]}"

BRANCH_NAME=$1
START_POINT=$2

# -n 時はスクリプト用途モード: 末尾の WORKTREE_PATH 以外の stdout を stderr に寄せる
if [ -n "$NO_EDITOR" ]; then
  exec 3>&1
  exec 1>&2
fi

START_POINT_SHA=""

if [ -n "$DETACH" ]; then
  if [ -z "$BRANCH_NAME" ]; then
    echo "Error: --detach にはコミット指定が必要です" >&2
    exit 1
  fi
  if ! COMMIT_SHA=$(git rev-parse --verify "$BRANCH_NAME^{commit}" 2> /dev/null); then
    echo "Error: コミットを解決できませんでした: $BRANCH_NAME" >&2
    exit 1
  fi
elif [ -z "$(git branch --list "$BRANCH_NAME")" ]; then
  REMOTE_EXISTS=$(git ls-remote --heads "$REMOTE" "$BRANCH_NAME" 2> /dev/null)
  if [ -z "$REMOTE_EXISTS" ]; then
    if [ -n "$ASSUME_YES" ]; then
      echo "Create branch: $BRANCH_NAME (auto-confirmed)"
    else
      read -p "Create branch: $BRANCH_NAME? (y/n): " -n 1 -r confirm
      echo
      if [ "$confirm" != "y" ]; then
        echo "Aborted"
        exit 1
      fi
    fi

    if [ -z "$START_POINT" ]; then
      git branch "$BRANCH_NAME"
    else
      git branch "$BRANCH_NAME" "$START_POINT"
    fi
    # 作成直後のブランチ先端は基点コミットそのもの
    if ! START_POINT_SHA=$(git rev-parse --verify "refs/heads/$BRANCH_NAME^{commit}" 2> /dev/null); then
      echo "Error: 作成したブランチを解決できませんでした: $BRANCH_NAME" >&2
      exit 1
    fi
  else
    git fetch "$REMOTE" "$BRANCH_NAME" > /dev/null 2>&1
    git branch -t "$BRANCH_NAME" "$REMOTE/$BRANCH_NAME"
  fi
fi

# worktree 登録は実体が消えても prune されるまで残る。存在するディレクトリだけを返す
get_worktree_path() {
  local branch=$1 path
  while IFS= read -r path; do
    [ -d "$path" ] || continue
    printf '%s\n' "$path"
    return 0
  done < <(git worktree list --porcelain \
    | grep -B 2 -xF -- "branch refs/heads/$branch" \
    | sed -n 's/^worktree //p')
  return 1
}

# 指定パスを占有している worktree のチェックアウト状態を返す。未登録なら非ゼロ
describe_worktree_at() {
  local target line matched=""
  # porcelain の worktree 行は symlink 解決済みの絶対パスで出るため揃える
  target=$(realpath -- "$1") || return 1
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        if [ "${line#worktree }" = "$target" ]; then matched=1; else matched=""; fi
        ;;
      detached)
        if [ -n "$matched" ]; then
          printf 'detached HEAD\n'
          return 0
        fi
        ;;
      "branch "*)
        if [ -n "$matched" ]; then
          printf 'branch %s\n' "${line#branch refs/heads/}"
          return 0
        fi
        ;;
    esac
  done < <(git worktree list --porcelain)
  return 1
}

ensure_excluded() {
  local pattern=$1
  local exclude_file
  exclude_file=$(git rev-parse --git-path info/exclude)
  if [ -f "$exclude_file" ] && grep -Fxq "$pattern" "$exclude_file"; then
    return 0
  fi
  mkdir -p "$(dirname "$exclude_file")"
  if [ -f "$exclude_file" ] && [ -s "$exclude_file" ] && [ -n "$(tail -c 1 "$exclude_file")" ]; then
    printf '\n' >> "$exclude_file"
  fi
  echo "$pattern" >> "$exclude_file"
}

# メインリポジトリ配下に用意する共有ディレクトリを作り、gitignore に登録する
setup_shared_directories() {
  mkdir -p \
    "$MAIN_REPO_ROOT/.share" \
    "$MAIN_REPO_ROOT/.claude" \
    "$MAIN_REPO_ROOT/$WORKTREE_DIR"
  ensure_excluded "/.share"
  ensure_excluded "/.claude"
  ensure_excluded "/$WORKTREE_DIR/"
  if [ -e "$MAIN_REPO_ROOT/CLAUDE.md" ]; then
    ensure_excluded "/CLAUDE.md"
  fi
}

setup_shared_directories

if [ -n "$DETACH" ]; then
  WORKTREE_PATH="$MAIN_REPO_ROOT/$WORKTREE_DIR/${COMMIT_SHA:0:12}"
  # detach では BRANCH_NAME に commit-ish が入っているため、POST_CREATE_CMD へは
  # GW_BRANCH_NAME を空で渡す
  BRANCH_NAME=""

  if [ ! -d "$WORKTREE_PATH" ]; then
    if ! git worktree add --detach -- "$WORKTREE_PATH" "$COMMIT_SHA"; then
      echo "Error: worktree の作成に失敗しました" >&2
      exit 1
    fi
  fi
else
  # Worktreeが存在していない場合は作成
  if [ -z "$(get_worktree_path "$BRANCH_NAME")" ]; then
    BRANCH_DIR_NAME=${BRANCH_NAME//\//__}
    WORKTREE_TARGET="$MAIN_REPO_ROOT/$WORKTREE_DIR/$BRANCH_DIR_NAME"
    if ! git worktree add -- "$WORKTREE_TARGET" "$BRANCH_NAME" > /dev/null; then
      if [ ! -e "$WORKTREE_TARGET" ]; then
        # 実体の消えた登録が別パスにある場合、git の fatal は `already used by worktree at ...` で prune を案内しないため添える
        echo "Error: worktree の作成に失敗しました (実体の消えた登録が残っている場合は git worktree prune を実行)" >&2
      elif OCCUPANT=$(describe_worktree_at "$WORKTREE_TARGET"); then
        echo "Error: $WORKTREE_TARGET は別の状態 ($OCCUPANT) の worktree として登録済みです" >&2
        echo "       同ディレクトリで git switch $BRANCH_NAME するか、git worktree remove してから再実行してください" >&2
      else
        echo "Error: $WORKTREE_TARGET が worktree 登録の無いディレクトリとして存在します。中身を退避・削除してから再実行してください" >&2
      fi
      exit 1
    fi
  fi

  WORKTREE_PATH=$(get_worktree_path "$BRANCH_NAME")
fi

# Worktreeが存在していない場合はエラーとする
if [ -z "$WORKTREE_PATH" ]; then
  echo "Error: Worktree not found" >&2
  exit 1
fi

# .claudeを共有する
if [ ! -e "$WORKTREE_PATH/.claude" ]; then
  ln -s "$MAIN_REPO_ROOT/.claude" "$WORKTREE_PATH/.claude"
fi

# .shareを共有する
if [ ! -e "$WORKTREE_PATH/.share" ]; then
  ln -s "$MAIN_REPO_ROOT/.share" "$WORKTREE_PATH/.share"
fi

# CLAUDE.mdを共有する (メインリポジトリに存在する場合のみ)
if [ -e "$MAIN_REPO_ROOT/CLAUDE.md" ] && [ ! -e "$WORKTREE_PATH/CLAUDE.md" ]; then
  ln -s "$MAIN_REPO_ROOT/CLAUDE.md" "$WORKTREE_PATH/CLAUDE.md"
fi

run_post_create_cmd() {
  GW_WORKTREE_PATH="$WORKTREE_PATH" \
    GW_MAIN_REPO_PATH="$MAIN_REPO_ROOT" \
    GW_BRANCH_NAME="$BRANCH_NAME" \
    GW_START_POINT_SHA="$START_POINT_SHA" \
    GW_TARGET_FILE="${TARGET_FILE:+$WORKTREE_PATH/$TARGET_FILE}" \
    GW_POST_SCRIPT_ARGS="$POST_SCRIPT_ARGS" \
    "$POST_CREATE_CMD"
}

if [ -n "$NO_EDITOR" ]; then
  if [ -n "$POST_CREATE_CMD" ]; then
    if ! POST_CREATE_OUTPUT=$(run_post_create_cmd); then
      echo "Error: POST_CREATE_CMD failed: $POST_CREATE_CMD" >&2
      exit 1
    fi
    echo "$WORKTREE_PATH" >&3
    if [ -n "$POST_CREATE_OUTPUT" ]; then
      echo "$POST_CREATE_OUTPUT" >&3
    fi
  else
    echo "$WORKTREE_PATH" >&3
  fi
  exit 0
fi

if [ -n "$POST_CREATE_CMD" ]; then
  if ! run_post_create_cmd; then
    echo "Error: POST_CREATE_CMD failed: $POST_CREATE_CMD" >&2
    exit 1
  fi
else
  echo "$WORKTREE_PATH"
fi
